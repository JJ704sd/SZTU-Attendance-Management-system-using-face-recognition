# =====================================================
# 智能考勤与实验室准入系统 — .gitignore
# =====================================================

# ---------- 敏感配置 ----------
.env
*.env.local

# ---------- 课程内部资料（不入公开仓库） ----------
# 课程要求 PDF 等学校内部文件
*.pdf
!docs/**/*.pdf
# 组员个人报告草稿（不入仓）
docs/202400502133-陈佳豪.pdf
docs/202400502133-陈佳豪.docx

# ---------- 本地工具产物（不入公开仓库） ----------
.opencode/
.mavis/
.worktrees/
# 组员个人报告草稿（不入仓）
# 组员个人报告草稿（不入仓）
docs/202400502133-陈佳豪.pdf
# 组员个人报告草稿（不入仓）
docs/202400502133-陈佳豪.pdf


# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# ---------- 虚拟环境 ----------
venv/
.venv/
env/
ENV/
.conda/

# ---------- 测试 / 覆盖率 ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- dlib 模型权重（运行时由 ensure_models 下载） ----------
models/*.dat
models/*.dat.bz2

# ---------- 人脸采集数据集 ----------
dataset/
*.jpg
*.jpeg
*.png
!docs/**/*.png
!docs/**/*.jpg
!README.md
!src/assets/**

# ---------- PyInstaller 产物 ----------
build/
dist/
# 显式保留 build.spec（手动维护）
# 其他自动生成的 spec 不入仓
*.spec.bak

# ---------- 日志 ----------
*.log
logs/

# ----------一次性审计/报告产物 (cleanup_audit_*.json 等) ----------
.cleanup_audit_*.json
*.audit.json

# ----------一次性录制脚本产物 (录视频产生的中间文件) ----------
*.vtt
*.tmp.narr*

# ----------一次性诊断脚本 (以 _ 开头不入仓) ----------
scripts/_*.py
