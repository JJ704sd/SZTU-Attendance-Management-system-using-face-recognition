# =====================================================
# 智能考勤与实验室准入系统 — 环境变量模板
# =====================================================
# ⚠️  第一次跑项目? 看 QUICKSTART.md 顶部"5 分钟跑起来"
# =====================================================
# 第 1 步: 复制本文件为 .env
#   Windows PowerShell:  Copy-Item .env.template .env
#   Windows CMD / macOS / Linux:  cp .env.template .env
#
# 第 2 步: 用记事本 / VSCode 打开 .env, 改 DB_PASSWORD
#   改成你 MySQL 实际 root 密码, 其他全部保持默认即可
#
# 第 3 步: 在 MySQL 里先建好空库:
#   CREATE DATABASE attendance_lab CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# =====================================================

# ---------- 数据库 (MySQL 8.0+) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# ⚠️ 必改: 你的 MySQL root 密码
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
DB_NAME=attendance_lab

# ---------- 人脸识别 ----------
# 出勤匹配阈值 (欧氏距离 <= 此值判定为同一人)
FACE_MATCH_THRESHOLD=0.45
# 采集样本数 (注册时拍照多少张)
FACE_SAMPLE_COUNT=30

# ---------- 安全 ----------
# 登录失败锁定阈值 (连续 N 次失败锁定)
LOGIN_MAX_ATTEMPTS=5

# ---------- W14: 多端登录签到 ----------
# 教师端弹二维码 → 手机扫码 → H5 签到，进程内嵌的 FastAPI 服务监听端口
# 默认 5180，冲突时 SigninWebServer.start() 自动 +1 重试 1 次
SIGNIN_WEB_PORT=5180
