# =====================================================
# 智能考勤与实验室准入系统 — 环境变量模板
# =====================================================
# 复制本文件为 .env 并填入实际配置：
#   cp .env.template .env
# Windows PowerShell:
#   Copy-Item .env.template .env
# 然后用文本编辑器打开 .env 修改 DB_PASSWORD 等
# =====================================================

# ---------- 数据库 (MySQL 8.0+) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# 必填: 你的 MySQL root 密码
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
DB_NAME=attendance_lab

# ---------- 人脸识别 ----------
# 出勤匹配阈值 (欧氏距离 <= 此值判定为同一人)
FACE_MATCH_THRESHOLD=0.45
# 采集样本数 (注册时拍照多少张)
FACE_SAMPLE_COUNT=30

# ---------- 安全 ----------
# 登录失败锁定阈值 (连续 N 次失败锁定)
LOGIN_MAX_ATTEMPTS=5
